            function RestrictFirstZero(e) {
                if (e.srcElement.value.length == 0 && e.which == 48) {
                    e.preventDefault();
                    return false;
                }
            };

            $(function () {
                $('.inputChekregType').on('keyup', function () {
                    var input = $(this).val();
                    if (input == 0) {
                    }
                    if (!isNaN(input)) {
                        $('.inputChGroup').addClass('isNumber');
                    }
                    else {
                        $('.inputChGroup').removeClass('isNumber')
                    }
                    if (input == "") {
                        $('.inputChGroup').removeClass('isNumber')
                    }

                })
            });

